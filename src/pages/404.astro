---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url } from '../lib/url';
---

<Base title="Page not found - IFrame URL Tester" noindex>
  <Header />
  <main id="main" class="sky grid min-h-[70vh] place-items-center px-4 pt-[72px] text-center text-white">
    <div>
      <p class="text-lime-gradient text-7xl font-bold">404</p>
      <h1 class="mt-3 text-3xl font-semibold">This page refused to load</h1>
      <p class="mx-auto mt-3 max-w-md text-white/75">Not because of X-Frame-Options — it just doesn’t exist.</p>
      <a href={url('/')} class="btn btn-primary btn-lg mt-8">Test a URL</a>
    </div>
  </main>
  <Footer />
</Base>
